# Python bytecode, environments, and local tooling
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.envrc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# IDE and notebook state
.idea/
.ipynb_checkpoints/

# Local model and experiment outputs
checkpoints/*.pt
checkpoints/*.json
outputs/*.json
outputs/*.csv
outputs/*.png
data/splits/*.json
data/processed/robustness/

# Datasets: never committed. Fetched per the README setup steps.
data/raw/**
!data/raw/**/.gitkeep
data/processed/**
!data/processed/**/.gitkeep

# Model weights and cached features.
# CLIP weights are downloaded on demand by open_clip and cached outside the
# repo (~/.cache/huggingface), so they are never committed. The trained probe
# is only ~10KB, so it IS committed -- see the exception below.
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
.cache/

# Exception: the trained probe and its calibration are small enough to ship,
# which is what makes the repo clone-and-run with no checkpoint hosting.
!checkpoints/probe.pkl
!checkpoints/calibration.json

# Streamlit secrets
.streamlit/secrets.toml
