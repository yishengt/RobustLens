# Python bytecode, environments, and local tooling
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.envrc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# IDE and notebook state
.idea/
.ipynb_checkpoints/

# Local model and experiment outputs
checkpoints/*.pt
checkpoints/*.json
outputs/*.json
outputs/*.csv
outputs/*.png

# Downloaded datasets (SID_Set shards are ~495 MB each)
data/sid_set/
*.parquet

# Images unpacked from dataset shards by scripts/extract_dataset.py.
# Regenerable from the parquet files; ~2 GB, thousands of files.
data/extracted/
.cache/
.huggingface/

# Streamlit secrets
.streamlit/secrets.toml

# Large model checkpoints anywhere in the tree, not just checkpoints/.
# Bombek1's pytorch_model.pt is 2.0GB and sits at the repository root;
# GitHub rejects files over 100MB, and git keeps blobs forever once added.
*.pt
*.pth
*.ckpt
*.safetensors

# macOS
.DS_Store
